LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
# Optional provider-specific model overrides; Gemini defaults to 3.5 Flash-Lite for research and 3.8 Flash for verification.
LLM_MODEL=
LLM_VERIFY_MODEL=
# With OpenRouter, unprefixed gpt-* names are mapped to openai/gpt-*.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VERIFY_MODEL=gpt-4.1
# Optional, after research is complete:
COMPOSIO_API_KEY=
COMPOSIO_CONNECTED_ACCOUNT_ID=
COMPOSIO_SHEET_ID=
REPO_URL=
DEPLOY_URL=

